        </mxCell>
        <mxCell id="subtitle" value="Stack parametrizada com 3 recursos de rede orquestrados por um único template: Parameters alimentam a criação, Outputs são exportados para reuso entre stacks, e um fluxo de Change Set demonstra atualização automatizada sem recriar recursos." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#545B64;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
