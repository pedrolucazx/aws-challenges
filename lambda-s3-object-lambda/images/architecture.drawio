        <mxCell id="title" value="Lambda + S3 — S3 Object Lambda (transformação em GetObject)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
